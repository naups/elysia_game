PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/elysia_game

# Secure Authentication (set to "true" to enable email+password + JWT)
ENABLE_SECURE_AUTH=false
JWT_ACCESS_SECRET=some-secure-access-secret-change-me
JWT_REFRESH_SECRET=some-secure-refresh-secret-change-me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_HASH_COST=12
SECURE_COOKIE=false
